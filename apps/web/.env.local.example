# Copy this file to .env.local and fill in every value before starting the dev server.
# Never commit .env.local to version control.
# See docs/ENVIRONMENT.md for full documentation on each variable.

# ── API ─────────────────────────────────────────────────────────────────────
# Full URL to the backend API including the /api suffix
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# ── App URL ─────────────────────────────────────────────────────────────────
# Production frontend origin — used for OG share URLs and metadataBase
# In development this can stay as localhost; set to your real domain in production
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Error tracking ──────────────────────────────────────────────────────────
# Both server and client use the same Sentry DSN for the web project
# Get from Sentry → glimpse-web → Settings → Client Keys (DSN)
# Leave empty to disable Sentry (safe for local development)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# ── Sentry source maps (CI / production builds only) ────────────────────────
# Not needed for local development — only set these in your CI environment
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=glimpse-web
