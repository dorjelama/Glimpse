# Copy this file to .env and fill in every value before starting the server.
# Never commit .env to version control.
# See docs/ENVIRONMENT.md for full documentation on each variable.

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://glimpse:glimpse@localhost:5432/glimpse?schema=public"

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Auth ────────────────────────────────────────────────────────────────────
# Production: generate with `openssl rand -hex 32` — minimum 64 hex characters
JWT_SECRET=change-me-in-production-use-a-long-random-string

# ── CORS ────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Admin ───────────────────────────────────────────────────────────────────
# The user with this email is auto-promoted to ADMIN role on first login
ADMIN_EMAIL=your@email.com

# ── Error tracking ──────────────────────────────────────────────────────────
# Get from Sentry → your project → Settings → Client Keys (DSN)
# Leave empty to disable Sentry (safe for local development)
SENTRY_DSN=

# ── Cloudflare R2 (file storage) ────────────────────────────────────────────
# Get from Cloudflare → R2 → Overview (Account ID) + Manage API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=glimpse-uploads
# S3 API endpoint: Cloudflare → R2 → your bucket → Settings → S3 API
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# Public URL base — two options:
#   Option A (default): Enable "Public access" on the R2 bucket; URL will be https://pub-<R2_ACCOUNT_ID>.r2.dev/<key>
#                       Leave R2_PUBLIC_DOMAIN empty.
#   Option B (custom domain): Add a custom domain in R2 bucket settings, then set it here:
R2_PUBLIC_DOMAIN=

# ── AWS SES (email) ──────────────────────────────────────────────────────────
# Get from AWS → IAM → your SES user → Security credentials
SES_REGION=ap-southeast-1
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
# Must be a verified sender address in SES
SES_FROM_EMAIL=hello@elegant.com.np
