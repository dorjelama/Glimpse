# Root-level env example — copy relevant sections into apps/api/.env and apps/web/.env.local

# ── Postgres (matches docker-compose.yml defaults) ──────────────────────────
DATABASE_URL="postgresql://glimpse:glimpse@localhost:5432/glimpse?schema=public"

# ── API (apps/api) ──────────────────────────────────────────────────────────
PORT=3001
JWT_SECRET=change-me-in-production-use-a-long-random-string
FRONTEND_URL=http://localhost:3000

# ── Web (apps/web) ──────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api

